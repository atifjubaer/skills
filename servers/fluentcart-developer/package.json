{
  "name": "fluentcart-developer",
  "version": "2.0.2",
  "description": "MCP server for FluentCart developer knowledge: documentation search, database schema lookup, hook discovery, reference reading, and boilerplate generation for gateways, licensing, customers, device licensing, trial guards and client SDKs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fluentcart-developer": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-skills.mjs",
    "verify": "node scripts/verify-stdio.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "fluentcart",
    "developer-tools",
    "ai-agent"
  ],
  "author": "Atif Jubaer",
  "license": "MIT",
  "homepage": "https://github.com/atifjubaer/skills/tree/main/servers/fluentcart-developer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atifjubaer/skills.git",
    "directory": "servers/fluentcart-developer"
  },
  "bugs": {
    "url": "https://github.com/atifjubaer/skills/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
