{
  "name": "fluentcart-skills",
  "version": "2.0.0",
  "private": true,
  "description": "FluentCart developer skill, shipped with its own MCP server",
  "scripts": {
    "build:servers": "npm --prefix servers/fluentcart-developer run build",
    "verify:servers": "npm --prefix servers/fluentcart-developer run verify",
    "check:skills": "node scripts/validate-skills.mjs",
    "check:package": "node scripts/check-package.mjs",
    "ci": "npm run check:skills && npm run check:package && npm run check:parity",
    "check:parity": "node scripts/check-server-parity.mjs",
    "sync:docs": "node scripts/sync-fluentcart-docs.mjs",
    "deploy:mcpize": "node scripts/deploy-mcpize.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atifjubaer/skills.git"
  },
  "homepage": "https://github.com/atifjubaer/skills#readme",
  "bugs": {
    "url": "https://github.com/atifjubaer/skills/issues"
  },
  "keywords": [
    "fluentcart",
    "wordpress",
    "ai-skills",
    "mcp",
    "claude-code",
    "cursor"
  ],
  "author": "Fastrsoft",
  "license": "MIT"
}
