# ---------- HTTP transport ----------
PORT=8080
# Comma-separated Host allowlist for DNS-rebinding protection.
# Set this to your public hostname(s) before deploying behind a proxy.
ALLOWED_HOSTS=

# ---------- Direct sales (Lemon Squeezy) ----------
# Optional: reject license keys that belong to a different store.
LS_STORE_ID=
# Lemon Squeezy product ids -> Playing Cards. A licence only unlocks the card
# it paid for. Leave all three empty to treat every valid licence as All-Access
# (single-product behaviour); a valid product id that matches none is core.
LS_PRODUCT_ALL_ACCESS=
LS_PRODUCT_FLUENTCART=
LS_PRODUCT_LEMONSQUEEZY=
# Ops escape hatch: comma-separated tokens that are always Pro (internal seats, CI).
VALID_LICENSE_KEYS=

# ---------- Marketplace gateways ----------
# Shared secrets handed to you by each marketplace. Tokens are compared in
# constant time; if unset, that gateway path is disabled (fails closed).
MCPIZE_GATEWAY_SECRET=
AGENSI_GATEWAY_SECRET=

# ---------- Local stdio ----------
# Unlocks Pro tools for a local session. This is a convenience switch, not a
# security boundary — anyone controlling the machine can set it.
PRO_LICENSE_KEY=
# Narrows a local key to specific cards, e.g. "fluentcart" or
# "fluentcart,lemonsqueezy". Unset = both cards. An unknown value fails closed.
PRO_CARDS=
