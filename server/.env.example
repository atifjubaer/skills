# ---------- HTTP transport ----------
PORT=8080
# Comma-separated Host allowlist for DNS-rebinding protection.
# Set this to your public hostname(s) before deploying behind a proxy.
ALLOWED_HOSTS=

# No licence, key or gateway secret is needed: every tool is free and MIT.
# A marketplace gateway may still authenticate callers at its own edge, but the
# server does not read those credentials — it registers the same ten tools for
# every session regardless of what headers arrive.
